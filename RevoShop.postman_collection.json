      "name": "Users",
      "item": [
        {
          "name": "Register User - Success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"securepassword123\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] },
            "description": "Happy path: creates a new user. Expect 201 with the user object (no password_hash in response)."
          }
        },
        {
          "name": "Register User - Missing Fields (Error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"incomplete@example.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] },
            "description": "Error case: missing username and password. Expect 400."
          }
        },
        {
          "name": "Register User - Duplicate Email (Error)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/users", "host": ["{{base_url}}"], "path": ["users"] },
            "description": "Error case: email already exists in seed data. Expect 409."
          }
        },
        {
          "name": "Get User by ID - Success",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/users/1", "host": ["{{base_url}}"], "path": ["users", "1"] },
            "description": "Happy path: fetch user 1 (alice_smith from seed data). Expect 200."
          }
        },
        {
          "name": "Get User by ID - Not Found (Error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/users/9999", "host": ["{{base_url}}"], "path": ["users", "9999"] },
            "description": "Error case: user does not exist. Expect 404."
